#include <HardwareSerial.h>

HardwareSerial E220(2);

// ESP32 pins
#define E220_RX   16
#define E220_TX   17
#define E220_M0   25
#define E220_M1   26
#define E220_AUX  27

void setup()
{
  // USB Serial Monitor
  Serial.begin(115200);

  // E220 UART
  E220.begin(9600, SERIAL_8N1, E220_RX, E220_TX);

  // E220 mode pins
  pinMode(E220_M0, OUTPUT);
  pinMode(E220_M1, OUTPUT);
  pinMode(E220_AUX, INPUT);

  // NORMAL MODE
  digitalWrite(E220_M0, LOW);
  digitalWrite(E220_M1, LOW);

  delay(1000);

  Serial.println("ESP32 E220 TRANSMITTER");
  Serial.println("----------------------");

  if (digitalRead(E220_AUX))
    Serial.println("E220 AUX = HIGH");
  else
    Serial.println("E220 AUX = LOW");

  Serial.println("E220 in NORMAL mode");
}

void loop()
{
  // Wait until E220 is ready
  if (digitalRead(E220_AUX) == HIGH)
  {
    E220.println("HELLO FROM ESP32");

    Serial.println("TX: HELLO FROM ESP32");
  }
  else
  {
    Serial.println("E220 BUSY");
  }

  delay(2000);
}
